<?xml version="1.0"?>
<SLM:system xmlns:SLM="http://www.qnx.com/SLM">
  <SLM:component name="flight">
    <SLM:command>@DIR@/FlightSW</SLM:command>
    <SLM:args>--transport qnx --m3 @SCENARIO@ --cycles 230 --log @DIR@/flight.csv --link-log @DIR@/link.csv</SLM:args>
    <SLM:stdout>@DIR@/flight.log</SLM:stdout>
    <SLM:stderr>@DIR@/flight.err</SLM:stderr>
    <SLM:waitfor wait="pathname" polltime="100:5000">/dev/name/local/fprime-m2</SLM:waitfor>
    <SLM:repair>none</SLM:repair>
  </SLM:component>
  <SLM:component name="advisor">
    <SLM:command>@DIR@/MlAdvisor</SLM:command>
    <SLM:args>--transport qnx --m3 @SCENARIO@</SLM:args>
    <SLM:depend state="session">flight</SLM:depend>
    <SLM:stdout iomode="a">@DIR@/advisor.log</SLM:stdout>
    <SLM:stderr iomode="a">@DIR@/advisor.err</SLM:stderr>
    <SLM:repair backoff="1">@REPAIR@</SLM:repair>
  </SLM:component>
  <SLM:module name="m3">
    <SLM:member>flight</SLM:member>
    <SLM:member>advisor</SLM:member>
  </SLM:module>
</SLM:system>
